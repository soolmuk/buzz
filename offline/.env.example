# Buzz offline stack — environment template.
#
# `scripts/install.sh` writes a real `.env` next to this file with generated
# secrets. Copy this file to `.env` and edit it by hand only if you are
# re-configuring an existing deployment or reproducing one elsewhere.
#
# Nothing here reaches the internet. The only address a client needs is
# RELAY_URL (and therefore OFFLINE_PUBLIC_HOST); everything else is a
# container name on the compose network.

# ── deployment identity ──────────────────────────────────────────────────────
# Release tag these images came from (written by install.sh from images.lock).
OFFLINE_RELEASE=CHANGE_ME
# IP address or DNS name clients use, e.g. 166.103.175.321 or buzz.intranet.
OFFLINE_PUBLIC_HOST=166.103.175.321
# Host port mapped to the relay's 3000. 80 makes http://<host> work with no
# port suffix.
OFFLINE_HTTP_PORT=80
# Loopback-only health/metrics probe port.
OFFLINE_HEALTH_PORT=18080
# Subnet for the relay's outward-facing (NAT-disabled) network. Change it only
# if it collides with the host's LAN; `scripts/lockdown.sh` reads it from the
# Docker network, so it does not need to be repeated there.
# OFFLINE_EDGE_SUBNET=10.42.250.0/24
# OFFLINE_EDGE_GATEWAY=10.42.250.1
# Public WebSocket URL. `install.sh` derives it from the two values above:
#   offline_http_port == 80 → ws://<host>
#   otherwise               → ws://<host>:<port>
# Set it explicitly for a reverse proxy, a different scheme, or a path.
RELAY_URL=ws://166.103.175.321

# ── images (local tags created by install.sh; never pulled) ─────────────────
OFFLINE_IMAGE_RELAY=buzz-offline/relay:CHANGE_ME
OFFLINE_IMAGE_POSTGRES=buzz-offline/postgres:CHANGE_ME
OFFLINE_IMAGE_REDIS=buzz-offline/redis:CHANGE_ME
OFFLINE_IMAGE_SILO=buzz-offline/silo:CHANGE_ME
OFFLINE_IMAGE_MC=buzz-offline/mc:CHANGE_ME

# ── secrets: generate once, never rotate silently, back up with the volumes ──
# 32-byte hex Nostr secret key: the relay's signing identity. Rotating it
# invalidates relay-signed artifacts and NIP-11 identity.
BUZZ_RELAY_PRIVATE_KEY=CHANGE_ME_64_HEX
# At least 32 characters; signs git-receive-pack hook callbacks.
BUZZ_GIT_HOOK_HMAC_SECRET=CHANGE_ME_64_HEX

# ── local data plane ────────────────────────────────────────────────────────
POSTGRES_DB=buzz
POSTGRES_USER=buzz
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
BUZZ_S3_ACCESS_KEY=CHANGE_ME
BUZZ_S3_SECRET_KEY=CHANGE_ME
BUZZ_S3_BUCKET=buzz-media

# ── optional knobs ──────────────────────────────────────────────────────────
# Object-store conformance probe at startup (leave true unless debugging).
BUZZ_GIT_CONFORMANCE_PROBE=true
# Closed relay: only these pubkeys may use it. Comma-separated hex; empty means
# open relay. See docs/deployment-identity.md.
# BUZZ_PUBKEY_ALLOWLIST=
# Owner pubkey for closed-relay mode.
# RELAY_OWNER_PUBKEY=
